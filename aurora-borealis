#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
if [ -x "${SCRIPT_DIR}/.venv/bin/python3" ]; then
    exec "${SCRIPT_DIR}/.venv/bin/python3" -m aurora_borealis.main "$@"
elif [ -x "${SCRIPT_DIR}/.venv/bin/python" ]; then
    exec "${SCRIPT_DIR}/.venv/bin/python" -m aurora_borealis.main "$@"
else
    exec python3 -m aurora_borealis.main "$@"
fi
